#!/usr/bin/env bash
# Decay · WSD 的 D 段（指数衰减）
# 2026-10-28 定稿：S1+S2 合并为 S（700k 步），Decay 紧接其后
# tok/step = 256 × 16384 = 4,194,304；20,000 步 × 4,194,304 = 83.9 B token
# 累计 720,000 步；decay 从 700,000 起算，恰好覆盖本段
# LR：lr(p) = peak × (min_lr/peak)^p,  p = (iter - 700,000) / 20,000
#     1e-3 → 1e-4（p=0.25 5.62e-4 / p=0.5 3.16e-4 / p=0.75 1.78e-4）
#
# 🚫 前置阻塞：blend_decay.tsv 里 SFT-2605(0.60) 与 SFT-Agent-2609(0.12) 尚未分词，
#    gen_blend.py 会直接报错退出 —— 本阶段需 data 线先完成分词。
STAGE="decay"
STAGE_DESC="Decay · 4.19M tok/step · 20k 步 · 83.9B token · 指数衰减 1e-3→1e-4"

ITERS=720000          # ⚠️ 累计步数（S 700k + Decay 20k）
START_ITER=700000
GBS=256
WARMUP=0
LR_DECAY_ITERS=20000  # D 段长度（launcher 语义：train_iters - lr_decay_iters 起衰减）
LR_DECAY_SHAPE="exponential"
SAVE_INTERVAL=2000    # 用户令 2026-10-26：每 2000 步一个 ckpt（Decay 20k 步 = 10 个，含末点）
BLEND_TSV="$BAIZE_LLM_HOME/configs/blend_decay.tsv"
