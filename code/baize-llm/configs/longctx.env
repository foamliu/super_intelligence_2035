#!/usr/bin/env bash
# 长上下文扩展（ABF）· 在 S2 之后、Decay 之前执行的可选阶梯
# 设计原则：
#   1) 训练主配方仍是 16K（S1/S2），长上下文只在扩展阶段用阶梯升 seq；
#   2) 全程 theta = 1e6（ABF，configs/common.env ROPE_THETA），已由 B1 实测覆盖到 1M；
#   3) 每一级保持 tok/microbatch/GPU = 16384（= seq/CP），避免显存顶格；
#   4) --name 与 S1/S2 相同（累计 iters 续跑），阶梯脚本负责算累积步数。
STAGE="longctx"
STAGE_DESC="Long-context ABF ladder（32K→64K→128K，CP 2/4/8，theta=1e6）"

SEQ="${SEQ:-32768}"
CP="${CP:-2}"
GBS="${GBS:-128}"
ITERS="${ITERS:-1070000}"     # 累计步数（由 longctx_ladder.sh 计算后覆盖）
START_ITER="${START_ITER:-1050000}"
WARMUP=0
LR_DECAY_ITERS=0              # 扩展期刻意不衰减（衰减留给最后的 Decay 阶段）
LR="${LR:-1e-3}"
SAVE_INTERVAL="${SAVE_INTERVAL:-2000}"
BLEND_TSV="$BAIZE_LLM_HOME/configs/blend_s1.tsv"
