#!/usr/bin/env bash
# S · stable 段（2026-10-28 定稿：S1+S2 合并为 S）
# tok/step = GBS × SEQ = 256 × 16384 = 4,194,304（名义 4M；DP16×SEQ=262,144 的整数倍）
# 700,000 步 × 4,194,304 = 2.94 T token
# LR：前 2000 步线性 warmup 到 1e-3，之后恒定（本段无 decay）
# 2026-10-28 运维令：GBS 128→256，ITERS 保持 700000，总 token 2.94T
STAGE="s1"
STAGE_DESC="S stable · 4.19M tok/step · 700k 步 · 2.94T token"

ITERS="${ITERS:-700000}"   # 累计步数（S 是第一阶段，故 = 本阶段步数）
START_ITER=0          # 本阶段起始迭代（续跑基准；epochs 对账用）
GBS="${GBS:-256}"      # 2026-10-28 定稿：GBS=256（4.19M tok/step × 700k = 2.94T）
WARMUP=2000
LR_DECAY_ITERS=0      # 无 D 段
SAVE_INTERVAL=2000    # 用户令 2026-10-26 收口：每 2000 步一个 ckpt（S=350 个 → 必须配合 prune）
BLEND_TSV="${BLEND_TSV:-$BAIZE_LLM_HOME/configs/blend_s1_preblend.tsv}"
