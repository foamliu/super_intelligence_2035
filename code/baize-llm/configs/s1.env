#!/usr/bin/env bash
# S1 · stable 段
# tok/step = GBS × SEQ = 128 × 16384 = 2,097,152（名义 2M；DP16×SEQ=262,144 的整数倍）
# 700,000 步 × 2,097,152 = 1.468 T token
# LR：前 2000 步线性 warmup 到 1e-3，之后恒定（本段无 decay）
STAGE="s1"
STAGE_DESC="S1 stable · 2.10M tok/step · 700k 步 · 1.468T token"

ITERS="${ITERS:-700000}"   # 累计步数（S1 是第一阶段，故 = 本阶段步数）。可 env 覆盖（方案A: gbs256→350000）
START_ITER=0          # 本阶段起始迭代（续跑基准；epochs 对账用）
GBS="${GBS:-128}"      # 方案A 验证：GBS=256 ITERS=350000 bash scripts/train.sh s1（总 token 不变 1.468T）
WARMUP=2000
LR_DECAY_ITERS=0      # 无 D 段
SAVE_INTERVAL=2000    # 用户令 2026-10-26 收口：每 2000 步一个 ckpt（S1=350 个 → 必须配合 prune）
BLEND_TSV="$BAIZE_LLM_HOME/configs/blend_s1.tsv"
