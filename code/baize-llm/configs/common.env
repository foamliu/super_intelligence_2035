#!/usr/bin/env bash
# ============================================================
# BaiZe-2B 预训练 · 全局配置（由 scripts/train.sh source）
# 定案 2026-10-26：AdamW + WSD(D 段 exponential) + graph OFF + TensorBoard .29:6006
# 改这里 = 改配方；必须 commit，禁止命令行临时覆盖后不留痕。
# ============================================================

# ---- 代码 / 环境 ----
BAIZE_TRAIN_CODE="${BAIZE_TRAIN_CODE:-/nas_train/app.e0031982/code/BaiZe-ISEDA2027}"
PY="${PY:-/nas_train/app.e0031982/miniforge3/envs/py310/bin}"
export PYTHONPATH="${PYTHONPATH:-/nas_train/app.e0031982/omegaconf_230}"

# ---- 数据 / 实验目录 ----
TOK_ROOT="${TOK_ROOT:-/nas_train/app.e0031982/datasets/baize-data/tokenized}"
TOKENIZER="${TOKENIZER:-$BAIZE_TRAIN_CODE/data/tokenizer_eod}"
EXP_ROOT="${EXP_ROOT:-$BAIZE_TRAIN_CODE/nemo_experiments}"

# ---- 模型 / 并行（16K · CP1 · DP16）----
ARCH="mamba2"
NAME="${NAME:-baize2b}"        # 三阶段共用同一 name ⇒ 自动从上一阶段最后一个 ckpt 续跑
SEQ="${SEQ:-16384}"            # 长上下文阶梯可覆盖（configs/longctx.env + longctx_ladder.sh）
TP="${TP:-1}"
CP="${CP:-1}"                  # 32K→2 / 64K→4 / 128K→8（保持 tok/mb/GPU=16384）
MBS="${MBS:-1}"
NNODES="${NNODES:-2}"
NPROC_PER_NODE="${NPROC_PER_NODE:-8}"
DP=$(( NNODES * NPROC_PER_NODE / (TP * CP) ))      # 16（CP>1 时变小）
MASTER_IP="${MASTER_IP:-10.239.2.12}"              # rank0 在 .12；rank1 在 .29（本脚本所在机）
MASTER_PORT="${MASTER_PORT:-29581}"

# ---- 优化器 / LR 调度 ----
OPTIMIZER="${OPTIMIZER:-adam}" # Megatron 标准 AdamW（p8_adamw 同口径：--optimizer adam）
LR="${LR:-1e-3}"
MIN_LR="${MIN_LR:-1e-4}"       # 0.1 × peak
LR_DECAY_STYLE="${LR_DECAY_STYLE:-WSD}"
LR_DECAY_SHAPE="${LR_DECAY_SHAPE:-exponential}"   # D 段 lr(p)=peak×(min/peak)^p；需 launcher 支持 --lr-decay-shape
WEIGHT_DECAY="${WEIGHT_DECAY:-}"   # 留空=沿用 launcher 默认；若支持 --weight-decay 且要 0.1 就填 0.1

# ---- 精度 / 性能 ----
PRECISION="${PRECISION:-bf16_mixed}"
FP8_RECIPE="${FP8_RECIPE:-tensorwise}"   # 与 #792 E1 实测 613,992 tok/s 同一档
CUDA_GRAPH_OFF="${CUDA_GRAPH_OFF:-1}"    # 1 ⇒ 不传 --enable-cuda-graph（16K 满速的必要条件）

# ---- RoPE / 位置编码（56 层中 4 层全注意力吃 RoPE）----
# 用户令 2026-10-26：RoPE 的 max embedding position = 1M。
# ⚠️ 本项目已实测（2026-10-06 B1）：只把 max_position 抬到 131072+ 而不改 rope_theta
#    ⇒ cos/sin 高频分量溢出 ⇒ **全 NaN**（连 4K 都 NaN）。
#    因此 max_pos=1M 必须与 rope_theta=1e6（ABF）一起改；与
#    run/baize_b1_longctx_extend.py 的 "ABF_1e6"（max_pos=1048576, theta=1e6）一致。
ROPE_THETA=1000000             # ABF：1e4 → 1e6
ROPE_MAX_POS=1048576           # 1M = 2^20（不是十进制 1,000,000）
ROPE_SCALING=""                # 训练期不启 PI/NTK/YaRN（theta=1e6 已覆盖 1M 位置）
ATTN_LAYERS=4                  # 56 层 = 4 全注意力 + 24 Mamba2 + 28 MLP（Nemotron-H 式）
ROPE_REQUIRED=1                # 1 ⇒ launcher 不支持 --rotary-base 时直接拒绝开跑（不许静默退回 1e4）

# ---- 监控 ----
TB_PORT=6006
TB_HOST="0.0.0.0"
TB_AUTOSTART=1                 # train.sh 启动训练后顺带拉起 TensorBoard

# ---- 性能/稳定性可调（2026-10-26 运维令 22:0x）----
# DataLoader workers/rank（recipe.py:387 读 BAIZE_NUM_WORKERS，默认 8）。
# 实测 OOM-kill 史：num_workers=8→step70崩 / =4→step90崩 / =2→step200崩（均在 .29）。
# 根因=worker 子进程 RSS 累积→.29 swap(8G)耗尽→内核 OOM-kill(SIGKILL,不可捕获)。
# .29 无 root 无法 swapoff/change swappiness；RAM 1.9T free 但 kernel 仍主动 swap。
# 2026-10-27 #803 定论：num_workers=0（主进程同步加载，无子进程→无 RSS 累积→无 OOM）。
# 16K-token batch 数据量极轻(8.4MB/step)，mmap 读取 <10ms，compute ~9s/step ⇒ IO 占比<1%。
# 损失=prefetch 重叠，但消除 swap thrashing 后 compute 反而更快（无 page fault）。
export BAIZE_NUM_WORKERS="${BAIZE_NUM_WORKERS:-0}"
# 2026-10-27 #806：fork-COW 根因的结构性修复（spawn）。默认留空=fork（保持当前
# nw=0 跑法不变，不破坏正在运行的 S1）。验证 spawn 时设：
#   BAIZE_DATALOADER_START_METHOD=spawn + BAIZE_NUM_WORKERS=4 + BAIZE_PERSISTENT_WORKERS=1
# 先 8 卡 smoke 免 OOM + 显存正常 + 吞吐≥500K 再切 16 卡。spawn 让 worker 不继承父进程
# 内存→消除 COW→允许 nw>0 不 OOM→恢复数据/计算 overlap→趋近 614K tok/s（#805 终判 308K）。
export BAIZE_DATALOADER_START_METHOD="${BAIZE_DATALOADER_START_METHOD:-}"
export BAIZE_PERSISTENT_WORKERS="${BAIZE_PERSISTENT_WORKERS:-0}"
# ETA 估算用的吞吐（tok/s）。运维令 22:0x：S1 gbs128 实测 ~480K，#792 gbs256 基线 613,992。
# 默认按 gbs256(方案A) 613,992 估；跑 gbs128 时设 ETA_TPS=480000 让 ETA 不再虚低。
ETA_TPS="${ETA_TPS:-613992}"

# ---- 其他 ----
SEED=1234
LOGDIR="/tmp"
TMP_MIN_KB=5000000             # /tmp 至少 5GB（p8 的既有门禁）
