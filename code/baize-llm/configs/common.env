#!/usr/bin/env bash
# ============================================================
# BaiZe-2B 预训练 · 全局配置（由 scripts/train.sh source）
# 定案 2026-10-26：AdamW + WSD(D 段 exponential) + graph OFF + TensorBoard .29:6006
# 改这里 = 改配方；必须 commit，禁止命令行临时覆盖后不留痕。
# ============================================================

# ---- 代码 / 环境 ----
BAIZE_TRAIN_CODE="${BAIZE_TRAIN_CODE:-/nas_train/app.e0031982/code/BaiZe-ISEDA2027}"
PY="${PY:-/nas_train/app.e0031982/miniforge3/envs/py310/bin}"
export PYTHONPATH="${PYTHONPATH:-/nas_train/app.e0031982/omegaconf_230}"

# ---- 数据 / 实验目录 ----
TOK_ROOT="${TOK_ROOT:-/nas_train/app.e0031982/datasets/baize-data/tokenized}"
TOKENIZER="${TOKENIZER:-$BAIZE_TRAIN_CODE/data/tokenizer_eod}"
EXP_ROOT="${EXP_ROOT:-$BAIZE_TRAIN_CODE/nemo_experiments}"

# ---- 模型 / 并行（16K · CP1 · DP16）----
ARCH="mamba2"
NAME="baize2b"                 # 三阶段共用同一 name ⇒ 自动从上一阶段最后一个 ckpt 续跑
SEQ=16384
TP=1
CP=1
MBS=1
NNODES=2
NPROC_PER_NODE=8
DP=$(( NNODES * NPROC_PER_NODE / (TP * CP) ))      # 16
MASTER_IP="${MASTER_IP:-10.239.2.12}"              # rank0 在 .12；rank1 在 .29（本脚本所在机）
MASTER_PORT="${MASTER_PORT:-29581}"

# ---- 优化器 / LR 调度 ----
OPTIMIZER="adam"               # Megatron 标准 AdamW（p8_adamw 同口径：--optimizer adam）
LR="1e-3"
MIN_LR="1e-4"                  # 0.1 × peak
LR_DECAY_STYLE="WSD"
LR_DECAY_SHAPE="exponential"   # D 段 lr(p)=peak×(min/peak)^p；需 launcher 支持 --lr-decay-shape
WEIGHT_DECAY=""                # 留空=沿用 launcher 默认；若支持 --weight-decay 且要 0.1 就填 0.1

# ---- 精度 / 性能 ----
PRECISION="bf16_mixed"
FP8_RECIPE="tensorwise"        # 与 #792 E1 实测 613,992 tok/s 同一档
CUDA_GRAPH_OFF=1               # 1 ⇒ 不传 --enable-cuda-graph（16K 满速的必要条件）

# ---- 监控 ----
TB_PORT=6006
TB_HOST="0.0.0.0"
TB_AUTOSTART=1                 # train.sh 启动训练后顺带拉起 TensorBoard

# ---- 其他 ----
SEED=1234
LOGDIR="/tmp"
TMP_MIN_KB=5000000             # /tmp 至少 5GB（p8 的既有门禁）
