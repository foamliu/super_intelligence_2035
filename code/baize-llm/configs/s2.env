#!/usr/bin/env bash
# ⚠️ 2026-10-28 定稿：S1+S2 已合并为 S（s1.env: GBS256, ITERS=700000）。
#    本文件保留为**回退选项**——若用户后续决定恢复 3 阶段（S1→S2→Decay），
#    则启用本文件（s1.env 改回 GBS128/ITERS=700000，s2.env 不变，decay.env 改回 ITERS=1070000）。
#    当前主路 = 2 阶段（S → Decay），不使用本文件。
#
# S2 · stable 段（承接 S1 的 ckpt，继续同一 WSD 的 stable 平台）
# tok/step = 256 × 16384 = 4,194,304（= #792 E1 实测过的同一档）
# 350,000 步 × 4,194,304 = 1.468 T token（累计 1,050,000 步）
# LR：已在 1e-3 平台，warmup=0；本段无 decay（D 段留给 Decay 阶段）
STAGE="s2"
STAGE_DESC="S2 stable · 4.19M tok/step · 350k 步 · 1.468T token（⚠️ 已被合并 S 取代，保留回退用）"

ITERS=1050000         # ⚠️ 累计步数（S1 700,000 + S2 350,000）— 仅回退 3 阶段时使用
START_ITER=700000
GBS=256
WARMUP=0
LR_DECAY_ITERS=0
SAVE_INTERVAL=2000    # 用户令 2026-10-26 收口：每 2000 步一个 ckpt（S2=175 个 → 必须配合 prune）
BLEND_TSV="$BAIZE_LLM_HOME/configs/blend_s1.tsv"
