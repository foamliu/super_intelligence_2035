DRC CHECK TEXT ALL
DRC MAXIMUM RESULTS ALL
DRC MAXIMUM VERTEX 4096
LAYOUT PRIMARY "*"

DRC RESULTS DATABASE "./ddcpb.results1" ASCII
DRC SUMMARY REPORT   "./ddcpb.summary1" HIER
PRECISION 10000

LAYOUT SYSTEM GDSII
DRC CELL NAME YES CELL SPACE XFORM ALL
//LAYOUT PATH "/home/gds/ddcpb/to_td/20250610_DFM/LP5TOP.gds"
LAYOUT PATH "/home/gds/ddcpb/ta8/LP5TOP.gds"


////////////////////////////////////////////////////////
//              define variable                       //
////////////////////////////////////////////////////////

//grid
VARIABLE GRID 0.0001

////////////////////////////////////////////////////////
//                                                    //
//                      Part of Core                  //
//                                                    //
////////////////////////////////////////////////////////

BORD_CORE = OR RLDEV_mark1 RLDEV_mark2 RLDEV_mark3 RLDEV_mark4 
//AAcmos = OR AT4_PCH AT4_NCH  AAMain == AAcmos
AA_All = OR AT4_PCH AT4_NCH AT4_Dummy2
PG_All = OR PG_drawing PG_NCH PG_PCH PG_DUMMY PG_NTAP PG_PTAP
PG_Main = OR PG_drawing PG_NCH PG_PCH PG_NTAP PG_PTAP

//===============================================
//  NW - Nwell DRC   
//===============================================

NW_CORE = NW_drawing NOT BORD_PERI
R_C_NW_L_02_L{
    @ Min - Length of NW [zigzag shape, edge length <0.390um] [in core : 0.175]  
    CONVEX EDGE NW_CORE ANGLE1>180 LENGTH1<0.390 ANGLE2<180 WITH LENGTH <0.175
}

R_C_NW_S_01_L{
    @ Min - Space of NW [in core:2.434]
    A1 = EXT NW_CORE < 2.434 SINGULAR OPPOSITE REGION
	A1 NOT INTERACT (AAcmos OR PG_Main)
	
}
//===============================================
//  NCH - NCH1/NCH2/NCH3 DRC   
//===============================================

NCH1_CORE = NCH1_drawing NOT BORD_PERI
NCH2_CORE = NCH2_drawing NOT BORD_PERI
NCH3_CORE = NCH3_drawing NOT BORD_PERI


R_C_NCH_L_02_L{
    @ Min - Length of NCH [zigzag shape, edge length <0.390um] [in core : 0.175] 
    CONVEX EDGE NCH1_CORE  ANGLE1 > 180 LENGTH1 < 0.390 ANGLE2 < 180 WITH LENGTH <0.175
	CONVEX EDGE NCH2_CORE ANGLE1 > 180 LENGTH1 < 0.390 ANGLE2 < 180 WITH LENGTH <0.175
	CONVEX EDGE NCH3_CORE ANGLE1 > 180 LENGTH1 < 0.390 ANGLE2 < 180 WITH LENGTH <0.175

}
R_C_NCH_S_01_M{
    @Min - Space of NCH [U shape] [in core:1.49]
    A1 = EXT NCH1_CORE < 1.49 SINGULAR OPPOSITE NOTCH REGION
	A2 = CONVEX EDGE NCH1_CORE == 0 
	A3 = EXPAND EDGE A2 OUTSIDE BY 0.001
	INTERACT A1 A3
    
	B1 = EXT NCH2_CORE < 1.49 SINGULAR OPPOSITE NOTCH REGION
	B2 = CONVEX EDGE NCH2_CORE == 0 
	B3 = EXPAND EDGE B2 OUTSIDE BY 0.001
	INTERACT B1 B3

	C1 = EXT NCH3_CORE < 1.49 SINGULAR OPPOSITE NOTCH REGION
	C2 = CONVEX EDGE NCH3_CORE == 0 
	C3 = EXPAND EDGE C2 OUTSIDE BY 0.001
	INTERACT C1 C3
}

//===============================================
//  PCH - PCH1 DRC   
//===============================================

PCH1_CORE = PCH1_drawing NOT BORD_PERI
PCH2_CORE = PCH2_drawing NOT BORD_PERI 
PCH3_CORE = PCH3_drawing NOT BORD_PERI  

R_C_PCH_L_02_L{
    @ Min - Length of PCH [zigzag shape, edge length <0.390um] [in core : 0.175] 
    CONVEX EDGE PCH1_CORE ANGLE1 > 180 LENGTH1 < 0.39 ANGLE2 < 180 WITH LENGTH <0.175
	CONVEX EDGE PCH2_CORE ANGLE1 > 180 LENGTH1 < 0.39 ANGLE2 < 180 WITH LENGTH <0.175
	CONVEX EDGE PCH3_CORE ANGLE1 > 180 LENGTH1 < 0.39 ANGLE2 < 180 WITH LENGTH <0.175
}


R_C_PCH_S_01_M{
    @ Min - Space of PCH [U shape] [in core:1.49]

	A1 = EXT PCH1_CORE < 1.49 SINGULAR OPPOSITE NOTCH REGION
	A2 = CONVEX EDGE PCH1_CORE == 0 
	A3 = EXPAND EDGE A2 OUTSIDE BY 0.001
	INTERACT A1 A3

	B1 = EXT PCH2_CORE < 1.49 SINGULAR OPPOSITE NOTCH REGION
	B2 = CONVEX EDGE PCH2_CORE == 0 
	B3 = EXPAND EDGE B2 OUTSIDE BY 0.001
	INTERACT B1 B3


	C1 = EXT PCH3_CORE < 1.49 SINGULAR OPPOSITE NOTCH REGION
	C2 = CONVEX EDGE PCH3_CORE == 0 
	C3 = EXPAND EDGE C2 OUTSIDE BY 0.001
	INTERACT C1 C3    
}


R_C_PCH_S_02 {
	@ Min - Space between PCH [width>5.216 um] and PCH, PRL > 31.5um	[in core: 1.416] 
	WIDE_PCH1 = PCH1_CORE  WITH WIDTH > 5.216
	poss_err1 = EXT WIDE_PCH1 PCH1_CORE  < 1.416 ABUT<90 SINGULAR OPPOSITE REGION MEASURE ALL
	poss_err1 ENCLOSE RECTANGLE 31.5 GRID


	WIDE_PCH2 = PCH2_CORE  WITH WIDTH > 5.216
	poss_err2 = EXT WIDE_PCH2 PCH2_CORE  < 1.416 ABUT<90 SINGULAR OPPOSITE REGION MEASURE ALL
	poss_err2 ENCLOSE RECTANGLE 31.5 GRID


	WIDE_PCH3 = PCH3_CORE  WITH WIDTH > 5.216
	poss_err3 = EXT WIDE_PCH3 PCH3_CORE  < 1.416 ABUT<90 SINGULAR OPPOSITE REGION MEASURE ALL
	poss_err3 ENCLOSE RECTANGLE 31.5 GRID

}



