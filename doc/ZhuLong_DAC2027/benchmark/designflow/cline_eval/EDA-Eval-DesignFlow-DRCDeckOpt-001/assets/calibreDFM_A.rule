    @ Min - Length of NLDD [zigzag shape, edge length <0.390um] [in Core:0.175]
    CONVEX EDGE NL1_CORE ANGLE1 > 180  LENGTH1 < 0.390 ANGLE2 < 180 WITH LENGTH < 0.175
	CONVEX EDGE NL2_CORE ANGLE1 > 180  LENGTH1 < 0.390 ANGLE2 < 180 WITH LENGTH < 0.175
	CONVEX EDGE NL3_CORE ANGLE1 > 180  LENGTH1 < 0.390 ANGLE2 < 180 WITH LENGTH < 0.175
	CONVEX EDGE NL4_CORE ANGLE1 > 180  LENGTH1 < 0.390 ANGLE2 < 180 WITH LENGTH < 0.175

}
R_C_NL_S_01_M{
    @ Min - Space of NLDD [U shape] [in core:1.49]
    A1 = EXT NL1_CORE  < 1.49 SINGULAR OPPOSITE NOTCH REGION
	A2 = CONVEX EDGE NL1_CORE  == 0 
	A3 = EXPAND EDGE A2 OUTSIDE BY 0.001
	INTERACT A1 A3 

	B1 = EXT NL2_CORE  < 1.49 SINGULAR OPPOSITE NOTCH REGION
	B2 = CONVEX EDGE NL2_CORE  == 0 
	B3 = EXPAND EDGE B2 OUTSIDE BY 0.001
	INTERACT B1 B3

	C1 = EXT NL3_CORE  < 1.49 SINGULAR OPPOSITE NOTCH REGION
	C2 = CONVEX EDGE NL3_CORE  == 0 
	C3 = EXPAND EDGE C2 OUTSIDE BY 0.001
