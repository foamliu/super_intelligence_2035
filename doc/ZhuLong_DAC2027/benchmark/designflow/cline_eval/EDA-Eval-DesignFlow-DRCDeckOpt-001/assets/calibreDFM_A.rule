	D1 = EXT NL4_CORE  < 1.49 SINGULAR OPPOSITE NOTCH REGION
	D2 = CONVEX EDGE NL4_CORE  == 0 
	D3 = EXPAND EDGE D2 OUTSIDE BY 0.001
	INTERACT D1 D3

    
}
