	@ Min - Space [PRL > 31.5um] between NLDD [width>5.216 um] and NLDD	[in core: 1.416] 
	WIDE_NL1 = NL1_CORE  WITH WIDTH > 5.216
	poss_err1 = EXT WIDE_NL1 NL1_CORE  < 1.416 ABUT<90 SINGULAR OPPOSITE REGION MEASURE ALL
	poss_err1 ENCLOSE RECTANGLE 31.5 GRID

	WIDE_NL2 = NL2_CORE  WITH WIDTH > 5.216
	poss_err2 = EXT WIDE_NL2 NL2_CORE  < 1.416 ABUT<90 SINGULAR OPPOSITE REGION MEASURE ALL
	poss_err2 ENCLOSE RECTANGLE 31.5 GRID

