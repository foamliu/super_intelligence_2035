    {"name": "via1_m1_m2",    "cut": "via1",    "lower": "metal1",  "upper": "metal2", "cut_size": [0.10, 0.10], "spacing": [0.10, 0.10], "enclosure": [0.05, 0.05]},
    {"name": "via2_m2_m3",    "cut": "via2",    "lower": "metal2",  "upper": "metal3", "cut_size": [0.10, 0.10], "spacing": [0.12, 0.12], "enclosure": [0.05, 0.05]}
  ],
  "global_nets": {
