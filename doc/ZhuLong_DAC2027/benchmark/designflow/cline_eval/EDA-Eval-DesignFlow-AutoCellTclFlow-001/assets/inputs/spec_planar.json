    "VSS":  ["vss", "VSS", "gnd"],
    "BODY": ["body", "VNW", "vpw"]
  },
  "design_rules": {
    "min_width_poly":      0.05,
    "min_spacing_poly":    0.07,
    "min_width_m1":        0.06,
