    "active":     {"layer": 2,  "datatype": 0},
    "nwell":      {"layer": 3,  "datatype": 0},
    "contact":    {"layer": 4,  "datatype": 0},
    "metal1":     {"layer": 10, "datatype": 0},
    "via1":       {"layer": 11, "datatype": 0},
    "metal2":     {"layer": 12, "datatype": 0},
    "via2":       {"layer": 13, "datatype": 0},
    "metal3":     {"layer": 14, "datatype": 0}
  },
  "layer_functions": {
