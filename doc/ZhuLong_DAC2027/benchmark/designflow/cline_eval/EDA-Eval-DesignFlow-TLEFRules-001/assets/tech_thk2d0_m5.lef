    PARALLELRUNLENGTH 0.00 1.50 4.50
      WIDTH 0.00      0.88 0.88 0.88
      WIDTH 1.50      1.00 1.00 1.00
      WIDTH 4.50      1.80 1.80 1.80 ;
  MAXWIDTH 12 ;
  RESISTANCE RPERSQ 0.01 ;
