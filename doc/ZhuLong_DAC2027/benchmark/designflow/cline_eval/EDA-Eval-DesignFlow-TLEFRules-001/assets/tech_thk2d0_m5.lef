END GENV4

VIARULE GENRDV GENERATE
  LAYER M5 ;
    ENCLOSURE 0.5 0.5 ;
  LAYER RDL ;
    ENCLOSURE 0.5 0.5 ;
  LAYER RDV ;
    RECT -1.5 -1.5 1.5 1.5 ;
    SPACING 5 BY 5 ;
END GENRDV

