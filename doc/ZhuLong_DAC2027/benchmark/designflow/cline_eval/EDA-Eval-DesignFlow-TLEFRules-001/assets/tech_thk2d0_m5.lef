VERSION 5.7 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;

PROPERTYDEFINITIONS
  LAYER LEF58_TYPE STRING "MAXVIASTACK 2 NOSINGLE RANGE M1 M5 ;" ;
END PROPERTYDEFINITIONS

UNITS
  DATABASE MICRONS 4000 ;
END UNITS
MANUFACTURINGGRID 0.00025 ;

SITE cxm3site
    SYMMETRY y  ;
    CLASS core  ;
    SIZE 47.5 BY 50.32 ;
END cxm3site

LAYER OVERLAP
  TYPE OVERLAP ;
END OVERLAP

LAYER BORD
   TYPE OVERLAP ;
END BORD

LAYER BORD_mark31
   TYPE OVERLAP ;
END BORD_mark31

LAYER BORD_mark32
   TYPE OVERLAP ;
END BORD_mark32

LAYER BORD_mark33
   TYPE OVERLAP ;
END BORD_mark33

LAYER BORD_mark34
   TYPE OVERLAP ;
END BORD_mark34

LAYER BORD_mark109
   TYPE OVERLAP ;
END BORD_mark109

LAYER BORD_mark110
   TYPE OVERLAP ;
END BORD_mark110

LAYER BORD_mark111
   TYPE OVERLAP ;
END BORD_mark111

LAYER BORD_mark116
   TYPE OVERLAP ;
END BORD_mark116

LAYER C4_bump   
   TYPE ROUTING ;
   DIRECTION VERTICAL ;
   WIDTH  15.0 ;
   PITCH  20.0 ;
   SPACING 9.0 ;
END C4_bump

LAYER TSV  # TSV cut layer between M1 & C4_bump 
   TYPE CUT ;
   SPACING 8.0 LAYER OVERLAP ;
END TSV

LAYER M1
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 9.76 9.76 ;
  WIDTH 8.88 ;
  OFFSET 0.88 0.88 ;
  AREA 4 ;
  SPACINGTABLE 
    PARALLELRUNLENGTH 0.00 1.50 4.50
      WIDTH 0.00      0.88 0.88 0.88
      WIDTH 1.50      1.00 1.00 1.00
      WIDTH 4.50      1.80 1.80 1.80 ;
  MAXWIDTH 12 ;
  RESISTANCE RPERSQ 0.01 ;
  THICKNESS 2.0 ;
  MINIMUMDENSITY 30 ;
  MAXIMUMDENSITY 75 ;
  DENSITYCHECKWINDOW 200 200 ;
  DENSITYCHECKSTEP 50 ;
END M1

LAYER V1
  TYPE CUT ;
  SPACING 0.68 ;
  SPACING 1.08 ADJACENTCUTS 3 WITHIN 1.1 ;
  ENCLOSURE BELOW 0.08 0.08 ;
  ENCLOSURE ABOVE 0.08 0.08 ;
  ENCLOSURE BELOW 0.37 0.37 WIDTH 5.0 ;
  ENCLOSURE ABOVE 0.37 0.37 WIDTH 5.0 ;
END V1

LAYER M2
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 9.76 9.76 ;
  WIDTH 8.88 ;
  OFFSET 0.88 0.88 ;
  AREA 4 ;
  SPACINGTABLE 
    PARALLELRUNLENGTH 0.00 1.50 4.50
      WIDTH 0.00      0.88 0.88 0.88
      WIDTH 1.50      1.00 1.00 1.00
      WIDTH 4.50      1.80 1.80 1.80 ;
  MAXWIDTH 12 ;
  RESISTANCE RPERSQ 0.01 ;
  THICKNESS 2.0 ;
  MINIMUMDENSITY 30 ;
  MAXIMUMDENSITY 75 ;
  DENSITYCHECKWINDOW 200 200 ;
  DENSITYCHECKSTEP 50 ;
END M2

LAYER V2
  TYPE CUT ;
  SPACING 0.68 ;
  SPACING 1.08 ADJACENTCUTS 3 WITHIN 1.1 ;
  ENCLOSURE BELOW 0.08 0.08 ;
  ENCLOSURE ABOVE 0.08 0.08 ;
  ENCLOSURE BELOW 0.37 0.37 WIDTH 5.0 ;
  ENCLOSURE ABOVE 0.37 0.37 WIDTH 5.0 ;
END V2

