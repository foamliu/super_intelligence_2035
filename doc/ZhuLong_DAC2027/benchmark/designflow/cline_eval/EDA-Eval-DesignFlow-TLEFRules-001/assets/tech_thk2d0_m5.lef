  ENCLOSURE BELOW 0.08 0.08 ;
  ENCLOSURE ABOVE 0.08 0.08 ;
  ENCLOSURE BELOW 0.37 0.37 WIDTH 5.0 ;
  ENCLOSURE ABOVE 0.37 0.37 WIDTH 5.0 ;
