VIARULE GENV1 GENERATE
  LAYER M1 ;
    ENCLOSURE 0.37 0.37 ;
    WIDTH 0.88 TO 14 ;
  LAYER M2 ;
    ENCLOSURE 0.08 0.08 ;
  LAYER V1 ;
    RECT -0.36 -0.36 0.36 0.36 ;
END GENV1

VIARULE GENV2 GENERATE
  LAYER M2 ;
    ENCLOSURE 0.08 0.08 ;
  LAYER M3 ;
    ENCLOSURE 0.08 0.08 ;
  LAYER V2 ;
    RECT -0.36 -0.36 0.36 0.36 ;
    SPACING 1.4 BY 1.4 ;
END GENV2

VIARULE GENV3 GENERATE
  LAYER M3 ;
    ENCLOSURE 0.08 0.08 ;
  LAYER M4 ;
    ENCLOSURE 0.08 0.08 ;
  LAYER V3 ;
    RECT -0.36 -0.36 0.36 0.36 ;
