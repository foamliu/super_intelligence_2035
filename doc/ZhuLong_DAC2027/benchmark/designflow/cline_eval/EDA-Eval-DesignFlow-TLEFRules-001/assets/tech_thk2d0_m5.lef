LAYER RDV
  TYPE CUT ;
  SPACING 2.0 ;
END RDV

LAYER RDL
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  WIDTH 3 ;
  SPACING 3 ;
  PITCH   6 ;
  OFFSET  2 ;
  RESISTANCE RPERSQ 0.012 ;
  THICKNESS 3.0 ;
END RDL

LAYER PA2
  TYPE CUT ;
  SPACING 52 ;
  PROPERTY LEF58_TYPE "TYPE PASSIVATION ;" ;
END PA2

LAYER uBump
  TYPE  CUT ;
  SPACING  52 ;
  PROPERTY LEF58_TYPE "TYPE PASSIVATION ;" ;
END uBump   

VIA VIA_TSV DEFAULT
    RESISTANCE 0.15 ;
    LAYER C4_bump ;
          RECT -0.44 -0.44 0.44 0.44 ; 
    LAYER TSV ;
          RECT -0.36 -0.36 0.36 0.36 ;
    LAYER M1 ;
          RECT -0.44 -0.44 0.44 0.44 ; 
END VIA_TSV

VIA VIA1_1cut DEFAULT
    RESISTANCE 0.15 ;
    LAYER M1 ;
          RECT -0.44 -0.44 0.44 0.44 ; 
    LAYER V1 ;
          RECT -0.36 -0.36 0.36 0.36 ;
    LAYER M2 ;
          RECT -0.44 -0.44 0.44 0.44 ; 
END VIA1_1cut

VIA VIA1_2cut DEFAULT 
    RESISTANCE 0.075 ;
    LAYER M1 ;
          RECT -1.14 -0.44 1.14 0.44 ; 
    LAYER V1 ;
          RECT -1.06 -0.36 -0.34 0.36 ;
          RECT  0.34 -0.36  1.06 0.36 ;
    LAYER M2 ;
          RECT -1.14 -0.44 1.14 0.44 ; 
END VIA1_2cut

VIA VIA1_4cut DEFAULT 
    RESISTANCE 0.0375 ;
    LAYER M1 ;
          RECT -1.225 -1.225 1.225 1.225 ; 
    LAYER V1 ;
          RECT -1.145 -1.145 -0.425 -0.425 ;
          RECT -1.145  0.425 -0.425  1.145 ;
          RECT  0.425 -1.145  1.145 -0.425 ;
          RECT  0.425  0.425  1.145  1.145 ;
    LAYER M2 ;
          RECT -1.225 -1.225 1.225 1.225 ; 
END VIA1_4cut

