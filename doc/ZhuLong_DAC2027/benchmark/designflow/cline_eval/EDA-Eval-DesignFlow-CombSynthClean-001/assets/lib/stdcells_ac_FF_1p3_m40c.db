# Synopsys Design Compiler Liberty library (text placeholder stub).
# Real binary .db omitted from the benchmark bundle; the synthesis flow
# references this file by path/name only. The checker never loads it.
# Corner: FF 1.3V -40C  (library name: FF_1p3_m40c)
library(stdcells_ac_FF_1p3_m40c) {
  technology(cmos);
  delay_model : table_lookup;
  voltage : 1.3;
  temperature : -40;
  capacitive_load_unit(1,pf);
  pulling_resistance_unit(1,kohm);
  leakage_power_unit : 1pW;
  time_unit : 1ns;
  cell(invLx1) { area:1.0; pin(Y){direction:output; function:"!A";} pin(A){direction:input;} }
  cell(invLx2) { area:2.0; pin(Y){direction:output; function:"!A";} pin(A){direction:input;} }
  cell(bufLx1) { area:1.0; pin(Y){direction:output; function:"A";}  pin(A){direction:input;} }
  cell(nand2x1){ area:1.5; pin(Y){direction:output; function:"!(A*B)";} pin(A){direction:input;} pin(B){direction:input;} }
  cell(nor2x1) { area:1.5; pin(Y){direction:output; function:"!(A+B)";} pin(A){direction:input;} pin(B){direction:input;} }
  cell(mux2x1) { area:2.0; pin(Y){direction:output; function:"(S&AB)|(!S&AA)";} pin(AA){direction:input;} pin(AB){direction:input;} pin(S){direction:input;} }
}
