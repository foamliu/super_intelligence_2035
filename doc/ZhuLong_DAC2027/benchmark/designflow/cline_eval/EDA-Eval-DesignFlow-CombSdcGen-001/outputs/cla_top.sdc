########################################################################
# SDC for module: cla_top
# Generated by gen_sdc.py
########################################################################

# Main clock
# cla_top is purely combinational (no clock input port),
# so a virtual clock is used as the common timing reference.
create_clock -name clk -period 10

# Input delays
set_input_delay -clock clk 2 [get_ports {a[15:0] b[15:0] cin}]
# Output delays
set_output_delay -clock clk 2 [get_ports {sum[15:0] cout}]