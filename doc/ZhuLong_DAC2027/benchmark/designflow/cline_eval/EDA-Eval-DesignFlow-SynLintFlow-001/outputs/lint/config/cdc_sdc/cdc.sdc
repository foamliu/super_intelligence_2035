# =============================================================================
# cdc.sdc : CDC (Clock Domain Crossing) 约束 (SGDC, SpyGlass / VC Static)
# 时钟: REFCLK(25MHz 参考) / FBCLK(VCO 反馈 ~25MHz, 与 REFCLK 异步)
# =============================================================================

# ------------------------------------------------------------------
# 1. 时钟定义
# ------------------------------------------------------------------
create_clock -name REFCLK -period 40.0 -waveform {0 20.0} [get_ports {REFCLK}]
create_clock -name FBCLK  -period 40.0 -waveform {0 20.0} [get_ports {FBCLK}]

# ------------------------------------------------------------------
# 2. 异步时钟组
# ------------------------------------------------------------------
set_clock_groups -asynchronous \
    -group [get_clocks {REFCLK}] \
    -group [get_clocks {FBCLK}]

# ------------------------------------------------------------------
# 3. 准静态配置输入 (校准时保持不变的常量输入)
#    WINDOW_LEN / THRESHOLD 由上层在上电阶段配置, 校准期间保持不变
# ------------------------------------------------------------------
quasi_static -name WINDOW_LEN [get_ports {WINDOW_LEN}]
quasi_static -name THRESHOLD [get_ports {THRESHOLD}]

# ------------------------------------------------------------------
# 4. 复位 (低有效异步复位, 各时钟域同步释放)
# ------------------------------------------------------------------
reset -name RST_N -value 0 [get_ports {RST_N}]