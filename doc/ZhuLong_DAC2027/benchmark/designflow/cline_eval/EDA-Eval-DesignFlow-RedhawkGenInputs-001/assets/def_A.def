VERSION 5.8 ;
DIVIDERCHAR / ;
BUSBITCHARS [] ;
DESIGN hl22_porting_test_chip_v1 ;
UNITS DISTANCE MICRONS 1000 ;

DIEAREA ( 0 0 ) ( 70000 70000 ) ;

SPECIALNETS 2 ;
- VDD
  ( 0 0 ) ( 70000 0 ) ( 70000 70000 ) ( 0 70000 )
  + ROUTED M3 0 + SHAPE STRIPE ( 0 0 ) ( 70000 0 ) ;
- VSS
  ( 5000 5000 ) ( 65000 5000 ) ( 65000 65000 ) ( 5000 65000 )
  + ROUTED M4 0 + SHAPE STRIPE ( 5000 5000 ) ( 65000 5000 ) ;
END SPECIALNETS

END DESIGN
