# Even for a top-level only verification, read in the RTL for the complete
# design, then the hierarchical designs will be removed and power model
# will be read in and use
if {$FM_MODE == "gate2gate"} {
    puts "RM-Info: Reading reference netlist: $FM_REF_NETLIST"
    read_verilog -r $FM_REF_NETLIST
} else {
    switch $RTL_SOURCE_FORMAT {
      autoread {
        # Source the script generated by autoread in Design Compiler
        rm_source -file ${OUTPUTS_DIR}/${DESIGN_NAME}.autoread_rtl.tcl
      }
      script {
        # The following setting allows the read script to be found in the search path
        set_app_var sh_source_uses_search_path true
        rm_source -file ${FMRM_RTL_READ_SCRIPT} -print FMRM_RTL_READ_SCRIPT
      }
      vhdl {
        read_vhdl -r ${RTL_SOURCE_FILES} -work_library WORK
      }
      sverilog {
        read_sverilog -r -vcs "-f ${RTL_SOURCE_FILES}" -work_library WORK
      }
      verilog {
        read_verilog -r -vcs "-f ${RTL_SOURCE_FILES}" -work_library WORK
      }
    }
}
