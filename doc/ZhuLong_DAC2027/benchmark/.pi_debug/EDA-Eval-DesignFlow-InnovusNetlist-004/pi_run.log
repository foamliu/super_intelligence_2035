Implementation verified on the Cadence WaveView Tcl sandbox. All 6 checker cases (A–F) passed with no errors.

## Solution

```tcl
proc def_net_connectivity_audit {nets_text specialnets_text} {
    set special_names {}
    foreach line [split $specialnets_text "\n"] {
        set t [string trim $line]
        if {[string match "- *" $t]} {
            lappend special_names [lindex [string range $t 2 end] 0]
        }
    }
    set nets {}
    set in_net 0
    set cur_name ""
    set cur_use ""
    set cur_pins {}
    set cur_dup 0
    foreach line [split $nets_text "\n"] {
        set t [string trim $line]
        if {$t eq ""} { continue }
        if {[string match "- *" $t]} {
            if {$in_net} { lappend nets [list $cur_name $cur_use $cur_pins $cur_dup] }
            set rest [string trim [string range $t 2 end]]
            set cur_name [lindex $rest 0]
            set cur_use ""
            if {[lindex $rest 1] eq "USE"} { set cur_use [lindex $rest 2] }
            set cur_pins {}
            set cur_dup 0
            set in_net 1
        } elseif {$in_net && ($t eq ";")} {
            lappend nets [list $cur_name $cur_use $cur_pins $cur_dup]
            set in_net 0
        } elseif {$in_net && [string match "(*" $t]} {
            set body [string trim $t "() "]
            set inst [lindex $body 0]
            set pin [lindex $body 1]
            set pair "$inst $pin"
            if {[lsearch -exact $cur_pins $pair] >= 0} {
                incr cur_dup
            } else {
                lappend cur_pins $pair
            }
        }
    }
    if {$in_net} { lappend nets [list $cur_name $cur_use $cur_pins $cur_dup] }

    set power_nets {}
    set single_pin_signal {}
    set unconnected_signal {}
    set connected_count 0
    set duplicate_connections 0
    set total_nets 0
    foreach net $nets {
        set name [lindex $net 0]
        set use [lindex $net 1]
        set pins [lindex $net 2]
        set dup [lindex $net 3]
        incr total_nets
        incr duplicate_connections $dup
        if {[lsearch -exact $special_names $name] >= 0} { lappend power_nets $name; continue }
        if {$use eq "POWER" || $use eq "GROUND"} { lappend power_nets $name; continue }
        if {$use eq "" && [lsearch -exact {VDD VSS GND VCC VEE} $name] >= 0} { lappend power_nets $name; continue }
        set n [llength $pins]
        if {$n >= 2} { incr connected_count } elseif {$n == 1} { lappend single_pin_signal $name } else { lappend unconnected_signal $name }
    }

    set verdict "clean"
    if {[llength $single_pin_signal] > 0 || [llength $unconnected_signal] > 0} { set verdict "dangling" }

    return [dict create total_nets $total_nets power_nets [lsort $power_nets] signal_nets_count [expr {$total_nets - [llength $power_nets]}] connected_count $connected_count single_pin_signal [lsort $single_pin_signal] unconnected_signal [lsort $unconnected_signal] duplicate_connections $duplicate_connections verdict $verdict]
}
```

