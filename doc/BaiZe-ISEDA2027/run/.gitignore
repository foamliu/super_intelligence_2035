# SFT/RL surrogate training output (large checkpoint files, not for git)
sft_surrogate_runs/
# Smoke test data duplicates (identical to main data dir, not needed in git)
sft_surrogate_data/*_smoke*/
# RL surrogate training checkpoints (large model weights ~15GB each, not for git;
# small JSON artifacts under rl_surrogate_runs/<run>/ ARE tracked: metrics.jsonl,
# cheat_rate.json, *_training_dynamics.json)
rl_surrogate_runs/*/global_step_*/

# ============================================================================
# 2026-11-20 用户令：清理 run/ ——「判断哪些不该被 track，该移除的移除，该删除的删除」
# 原则（用户原话）：agent 做事从来都是从头写脚本，根本不会寻找和复用以前的脚本
#   ⇒ 一次性产物 / 运行日志 / 可再生成中间物 一律不 track，只留在评测机本地。
#   保留：脚本(.py/.sh)、任务书/记忆(.md)、报告(.html)、配置/输入(.json/.yaml)。
# ============================================================================

# ---- 1) 运行日志：绝不进仓库（harness 388 / longctx 26 / p911f 14 ... 共 460 个）----
*.log
!**/required_*.log

# ---- 2) 违规上传的模型权重（~11MB，绝不该进 git；应由 HF/本地路径管理）----
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# ---- 3) 可再生成的污染检测哈希表（99.5MB，由 build_blacklist.py 生成）----
#      源脚本 build_blacklist.py 保留；需要时在机器上重跑生成。
data_pipeline/blacklist/meta.json
data_pipeline/blacklist/ngram_hashes.txt
data_pipeline/blacklist/short_ngram_hashes.txt
data_pipeline/blacklist/entry_points.sha256
data_pipeline/blacklist_extended/meta.json
data_pipeline/blacklist_extended/ngram_hashes.txt
data_pipeline/blacklist_extended/short_ngram_hashes.txt
data_pipeline/blacklist_extended/entry_points.sha256

# ---- 4) 评测/冒烟结果目录（原始结果留评测机本地，与上层 .gitignore 同一口径）----
baize_l3_tb_smoke_results/
baseline_eval_results/
longctx_eval_results/
p911e_results/
p911f_results/
results_dualnode_seq16k32k/
smoke_test_results/
scaling_report/
rca_collapse_evidence/
pretrain_cpu_eval_gguf/
attribution_3615_run*/

# ---- 5) 训练语料派生物（可再生成；源脚本 gen_* / build_* 保留）----
*.parquet
sft_mixed_output.jsonl

# ---- 6) vision 侧实验产物（wave_rl 大 jsonl 由 run_*.sh 生成）----
vision/wave_rl/sft_pilot_*.jsonl
vision/wave_rl/sft_holdout_*.jsonl
vision/wave_rl/v*/**/adapter_model.*
vision/data_snapshot_*.txt

# ---- 7) 编辑器/系统垃圾 ----
.DS_Store
Thumbs.db
*.swp
*.tmp
*.bak
*.orig
__pycache__/
*.pyc

