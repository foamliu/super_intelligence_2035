+class BlendHotSwitchRandomSampler:
+    """Sequential, DP-sharded sampler for Plan F blend hot-switch.
+
+    Unlike ``MegatronPretrainingRandomSampler`` (which derives
+    ``epoch = consumed_samples // active_total_samples`` and reshuffles per
+    epoch), this sampler consumes samples **strictly in order** (0, 1, 2, …)
+    with DP sharding. This makes per-source progress deterministically
+    recoverable via ``numpy.bincount(dataset_index[:consumed])``, which is the
+    foundation of the zero-overlap cursor mapping in
+    ``BlendedDataset.update_weights``.
+
+    When ``--blend-hot-switch`` is OFF, this class is never instantiated and
+    the stock sampler (with its per-epoch shuffle) is used — byte-identical to
+    unpatched Megatron.
+    """
+
+    def __init__(self, dataset, total_samples, consumed_samples,
+                 micro_batch_size, data_parallel_rank, data_parallel_size,
+                 data_sharding):
+        self.dataset = dataset
+        self.total_samples = total_samples
+        self.consumed_samples = consumed_samples
+        self.micro_batch_size = micro_batch_size
+        self.data_parallel_rank = data_parallel_rank
+        self.data_parallel_size = data_parallel_size
+        self.data_sharding = data_sharding
+        self.micro_batch_times_data_parallel_size = \
+            self.micro_batch_size * data_parallel_size
+        self.last_batch_size = \
+            self.total_samples % self.micro_batch_times_data_parallel_size
+        self._switched = False
+
+        assert self.total_samples > 0
+        assert self.micro_batch_size > 0
+        assert data_parallel_size > 0
+        assert self.data_parallel_rank < data_parallel_size
+
+    def __len__(self):
+        return self.total_samples
+
+    def update_consumed(self, consumed_samples, total_samples=None):
+        """Called after a blend switch to reset the cursor."""
+        self.consumed_samples = consumed_samples
+        if total_samples is not None:
+            self.total_samples = total_samples
+            self.last_batch_size = \
+                self.total_samples % self.micro_batch_times_data_parallel_size
+        self._switched = True
+
+    def __iter__(self):
+        active_total_samples = self.total_samples - self.last_batch_size
+        epoch = self.consumed_samples // active_total_samples
+        current_epoch_samples = self.consumed_samples % active_total_samples
+
+        if self.data_sharding:
+            current_epoch_samples = current_epoch_samples // \
+                self.micro_batch_times_data_parallel_size
+            current_epoch_samples *= self.micro_batch_times_data_parallel_size
+
+        for idx in range(current_epoch_samples, active_total_samples):
+            batch = idx % self.micro_batch_times_data_parallel_size
+            if self.data_sharding:
+                batch = batch // self.micro_batch_size
+                if batch != self.data_parallel_rank:
+                    continue
+            yield idx
+
+    @property
+    def switched(self):
+        return self._switched
+
