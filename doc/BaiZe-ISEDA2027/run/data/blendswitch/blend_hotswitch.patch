+def maybe_trigger_blend_switch(train_data_iterator, iteration, args):
+    """Plan F: trigger S1->S2 blend switch at ``args.blend_switch_step``.
+
+    Called from the train loop on every iteration. When the switch step is
+    reached (and not yet executed), this function:
+      1. Computes ``consumed_per_source`` from the current BlendedDataset's
+         ``dataset_index[:consumed]`` (deterministic because
+         BlendHotSwitchRandomSampler consumes in order).
+      2. Loads the S2 blend config from ``args.blend_switch_config`` (JSON).
+      3. Creates a ``BlendSwitcher`` and calls
+         ``blended_dataset.update_weights()`` to rebuild the blend index with
+         per-source cursor offsets (zero S1/S2 document overlap).
+      4. Resets the sampler's ``consumed_samples`` to 0 so S2 iterates over the
+         freshly-built index from the start.
+
+    Returns True if a switch was performed, False otherwise.
+    """
+    if not getattr(args, 'blend_hot_switch', False):
+        return False
+    switch_step = getattr(args, 'blend_switch_step', 0)
+    if switch_step <= 0:
+        return False
+    if getattr(args, '_blend_switch_done', False):
+        return False
+    if iteration != switch_step:
+        return False
+
+    import json
+    import numpy
+    from megatron.core.datasets.blend_switcher import BlendSwitcher
+
+    batch_sampler = getattr(train_data_iterator, 'batch_sampler', None)
+    if batch_sampler is None:
+        loader = getattr(train_data_iterator, 'loader', train_data_iterator)
+        batch_sampler = getattr(loader, 'batch_sampler', None)
+    if batch_sampler is None:
+        return False
+
+    blended_dataset = batch_sampler.dataset
+    consumed = batch_sampler.consumed_samples
+
+    dataset_index = blended_dataset.dataset_index
+    consumed_per_source = numpy.bincount(
+        dataset_index[:consumed], minlength=len(blended_dataset.weights)
+    ).astype(numpy.int64)
+
+    with open(args.blend_switch_config, 'r') as f:
+        cfg = json.load(f)
+    new_weights = cfg['new_weights']
+    new_size = cfg['new_size']
+    shared_mask = cfg.get('shared_source_mask', [True] * len(new_weights))
+    source_keys = cfg.get('source_keys', None)
+
+    switcher = BlendSwitcher(
+        num_sources=len(blended_dataset.weights),
+        source_keys=source_keys,
+    )
+    switcher.consumed_per_source = consumed_per_source
+    new_di, new_dsi = switcher.switch_weights(new_weights, new_size, shared_mask)
+
+    blended_dataset.dataset_index = new_di
+    blended_dataset.dataset_sample_index = new_dsi
+    blended_dataset.weights = new_weights
+    blended_dataset.size = new_size
+    blended_dataset.blend_switcher = switcher
+
+    batch_sampler.update_consumed(0, total_samples=new_size)
+
+    args._blend_switch_done = True
+    args._blend_consumed_per_source = consumed_per_source.tolist()
+    try:
+        from megatron.training import print_rank_0
+        print_rank_0(f'[blend-hot-switch] S1->S2 switch at iteration {iteration}: '
+                     f'consumed_per_source={consumed_per_source.tolist()}, '
+                     f'new_weights={new_weights}, new_size={new_size}')
+    except Exception:
+        print(f'[blend-hot-switch] S1->S2 switch at iteration {iteration}: '
+              f'consumed_per_source={consumed_per_source.tolist()}, '
+              f'new_weights={new_weights}, new_size={new_size}')
+    return True
+
