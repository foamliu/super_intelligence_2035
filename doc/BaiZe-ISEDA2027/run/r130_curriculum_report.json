  "verl_config": "# BaiZe Post-Train GRPO Curriculum Configuration (R130)\n# Integrates R74 (Adaptive) + R128 (3347 tasks) + R129 (R5 reward)\n# Generated: 2026-11-10 | Surrogate design, not validated on BaiZe\n\ntrainer:\n  total_epochs: 1\n  save_freq: 50\n  project_name: baize_posttrain_rl\n\nactor:\n  learning_rate: 1e-05\n  kl_coeff: 0.04\n  clip_range: 0.2\n  entropy_coeff: 0.001\n  context_length: 16384\n\nrollout:\n  name: sglang\n  multi_turn: true\n  mode: async\n  group_size: 8\n  max_turns: 10\n\nreward:\n  function: compute_score_with_process  # R129 R5\n  outcome_arm: R2\n  process_layer: R5\n  antigame_enabled: true\n  efficiency_penalty: true\n  recovery_diminishing: 0.85\n\ndata:\n  train_files: rl_pyaether_synth_v2_verified.jsonl  # R128\n  contamination_check: true\n\ncurriculum:\n  - phase: 0\n    name: Warmup\n    levels: ['L1']\n    steps: 50\n    reward_arm: R0\n    r5_enabled: False\n    replay_ratio: 0.0\n    sampling: uniform_within_level\n    lr: 1e-05\n    kl: 0.04\n    advance_criteria:\n      min_pass_rate: 0.7\n      min_steps: 30\n      min_adv_std: 0.05\n\n  - phase: 1\n    name: Foundation\n    levels: ['L1', 'L2']\n    steps: 100\n    reward_arm: R2\n    r5_enabled: True\n    replay_ratio: 0.15\n    sampling: adaptive\n    lr: 1e-05\n    kl: 0.04\n    advance_criteria:\n      min_pass_rate: 0.6\n      min_steps: 60\n      min_adv_std: 0.05\n\n  - phase: 2\n    name: Development\n    levels: ['L2', 'L3']\n    steps: 150\n    reward_arm: R2\n    r5_enabled: True\n    replay_ratio: 0.2\n    sampling: adaptive\n    lr: 8e-06\n    kl: 0.04\n    advance_criteria:\n      min_pass_rate: 0.5\n      min_steps: 80\n      min_adv_std: 0.05\n\n  - phase: 3\n    name: Refinement\n    levels: ['L3', 'L4']\n    steps: 150\n    reward_arm: R3\n    r5_enabled: True\n    replay_ratio: 0.25\n    sampling: adaptive\n    lr: 5e-06\n    kl: 0.04\n    advance_criteria:\n      min_pass_rate: 0.4\n      min_steps: 80\n      min_adv_std: 0.05\n\n  - phase: 4\n    name: Mastery\n    levels: ['L4', 'L5']\n    steps: 100\n    reward_arm: R3\n    r5_enabled: True\n    replay_ratio: 0.3\n    sampling: adaptive\n    lr: 3e-06\n    kl: 0.04\n\nanti_cheat:\n  ptu_hook: true  # PreToolUse (R69, R75)\n  cheat_rate_report: true\n  critical_hack_abort: true  # H2/H3/H4 -> stop\n  max_cheat_rate: 0.05\n\nsandbox:\n  type: local  # or ssh_tunnel (R1 Tunnel-SOP)\n  parallel: 4\n  timeout_per_call: 30\n  api_whitelist: true  # PTU-04\n  call_ordering: true  # PTU-05\n\neval:\n  dataset: EDA-Eval-PyAether-v20260311.jsonl  # 158 tasks\n  n_runs: 5  # 5-run mean+std\n  timeout: 2500\n  parallel: 8\n  fresh_context: true",
